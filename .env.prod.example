# Copy to .env.prod and fill in secrets before: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_USER=musiclab
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=musiclab
JWT_SECRET=change-me-long-random-secret

# Public site URL for CORS (comma-separated if multiple origins).
CORS_ORIGIN=http://localhost

# Same-origin Nginx: leave empty. Separate API host: https://api.yoursite.com
PUBLIC_API_URL=

HTTP_PORT=80
