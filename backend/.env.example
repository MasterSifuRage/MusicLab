PORT=4000
# Local với user postgres:
DATABASE_URL=postgresql://postgres:admin@localhost:5432/musiclab
# Hoặc user riêng:
# DATABASE_URL=postgresql://musiclab:musiclab@localhost:5432/musiclab
JWT_SECRET=change-me-in-production
UPLOAD_DIR=./uploads
RENDER_DIR=./renders
CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
# Set false when running a dedicated worker container (docker-compose.prod.yml)
EMBEDDED_WORKER=true
# true when Express serves frontend/dist from ./public (Render Docker, same-origin)
SERVE_SPA=false
